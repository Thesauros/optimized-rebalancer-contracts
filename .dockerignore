# allowlist: the ops image needs only these (see ops/Dockerfile)
*
!ops/package.json
!ops/package-lock.json
!ops/tsconfig.json
!ops/src
!ops/scripts
!deploy/crosschain/registry.ts
# one glob, not a line per chain: `*` matches a single path segment, so this admits
# exactly deployments/<key>/crosschain.json for every network, present or future
!deployments/*/crosschain.json

# Deployer private key (WITH 0x prefix)
DEPLOYER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Alchemy project ID
ALCHEMY_PROJECT_ID=your-alchemy-project-id

# Etherscan API key (V2 multichain; used for contract verification on Base)
ETHERSCAN_API_KEY=your-etherscan-api-key

# Protocol treasury address
TREASURY_ADDRESS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Full RPC URL for testing
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_project_id

# Management fee percent in wad (1e18 = 100%, max 0.05 * 1e18 = 5%)
# Default: 0
MANAGEMENT_FEE_PERCENT=

# Performance fee percent in wad (1e18 = 100%, max 0.2 * 1e18 = 20%)
# Default: 0
PERFORMANCE_FEE_PERCENT=

# Timelock delay in seconds (min 1800 = 30 minutes, max 2592000 = 30 days)
# Default: 1800
TIMELOCK_DELAY=

# Base-only TRON connector deployment
# Defaults to the deployed Base USDC Rebalancer when omitted.
BASE_REBALANCER=0xCA6029f2d5f5d36DA047206Ae7A254Fa80F579B8
# Owner should be a Base multisig or timelock. Defaults to TREASURY_ADDRESS.
BASE_CONNECTOR_OWNER=
# Defaults to deBridge Universal DLN Hook on Base.
BASE_DEPOSIT_EXECUTOR=0xAE0361b1C3454b297129e01046057F1D294c7974
# 20-byte TVM hex address without the TRON 0x41 network prefix.
TRON_GATEWAY_ADDRESS=
# Official TRON USDT and the project-owned TRON DMP messenger adapter, in TVM hex form.
TRON_USDT_ADDRESS=
TRON_MESSENGER_ADAPTER=
# Gas forwarded by the atomic DLN withdrawal hook on TRON.
TRON_WITHDRAWAL_HOOK_GAS=1000000
# Optional deBridge integrator referral code.
DEBRIDGE_REFERRAL_CODE=0
# Set only when verification will be run separately.
SKIP_VERIFY=false

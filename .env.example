# Deployer private key (WITH 0x prefix)
DEPLOYER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Alchemy project ID
ALCHEMY_PROJECT_ID=your-alchemy-project-id

# Etherscan API key (V2 multichain; used for contract verification on Base)
ETHERSCAN_API_KEY=your-etherscan-api-key

# Protocol treasury address
TREASURY_ADDRESS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Full RPC URL for testing
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_project_id

# Management fee percent in wad (1e18 = 100%, max 0.05 * 1e18 = 5%)
# Default: 0
MANAGEMENT_FEE_PERCENT=

# Performance fee percent in wad (1e18 = 100%, max 0.2 * 1e18 = 20%)
# Default: 0
PERFORMANCE_FEE_PERCENT=

# Timelock delay in seconds (min 1800 = 30 minutes, max 2592000 = 30 days)
# Default: 1800
TIMELOCK_DELAY=

# Base connector deployment. Defaults to the deployed Base USDC Rebalancer.
BASE_REBALANCER=0xCA6029f2d5f5d36DA047206Ae7A254Fa80F579B8
# Owner must be a Base multisig or timelock. Defaults to TREASURY_ADDRESS.
BASE_CONNECTOR_OWNER=
# Defaults to deBridge Universal DLN Hook on Base.
BASE_DEPOSIT_EXECUTOR=0xAE0361b1C3454b297129e01046057F1D294c7974
# Generated by `npm run deploy:tron-connector`. These three values are copied
# from deployments/tron/<network>-deployment.json -> baseEnv.
# 20-byte TVM hex addresses without the TRON 0x41 network prefix.
TRON_GATEWAY_ADDRESS=
TRON_USDT_ADDRESS=
TRON_MESSENGER_ADAPTER=
# Gas forwarded by the atomic DLN withdrawal hook on TRON.
TRON_WITHDRAWAL_HOOK_GAS=1000000
# Optional deBridge integrator referral code.
DEBRIDGE_REFERRAL_CODE=0
# Set only when verification will be run separately.
SKIP_VERIFY=false

# TRON deployment -----------------------------------------------------------
# Start on Nile. `mainnet` enables the official mainnet protocol defaults.
TRON_NETWORK=nile
TRON_FULL_HOST=https://nile.trongrid.io
TRON_DEPLOYER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TRONGRID_API_KEY=
# Final TRON multisig/owner. Deployment is initially controlled by deployer
# until the Base addresses are paired by `npm run configure:tron-connector`.
TRON_CONNECTOR_OWNER=

# Required on Nile. On mainnet the deploy script defaults to official deBridge
# DMP gate, DLN source, Universal Hook, and official TRON USDT contracts.
TRON_DEBRIDGE_GATE=
TRON_DLN_SOURCE=
TRON_PAYOUT_EXECUTOR=
TRON_USDT_CONTRACT=

TRON_FEE_LIMIT=1000000000
TRON_ORIGIN_ENERGY_LIMIT=10000000
TRON_USER_FEE_PERCENTAGE=100
BASE_DEPOSIT_HOOK_GAS=1000000

# Optional inputs to the final pairing step. When omitted, addresses are read
# from hardhat-deploy artifacts under deployments/base/.
BASE_CONNECTOR_ADDRESS=
BASE_MESSENGER_ADAPTER_ADDRESS=

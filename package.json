{
  "name": "thesauros-optimized-rebalancer",
  "scripts": {
    "build": "hardhat compile",
    "test": "forge test",
    "compile:tron": "tronbox compile --all",
    "deploy:tron-connector": "npm run compile:tron && node scripts/deploy-tron-connector.js",

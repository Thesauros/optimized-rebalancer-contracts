[Unit]
Description=Thesauros cross-chain autonomous health check and recovery
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/root/optimized-rebalancer-contracts/ops/.env.server
ExecStart=/usr/bin/python3 /usr/local/sbin/xc-autofix-watchdog
WorkingDirectory=/root/optimized-rebalancer-contracts
StateDirectory=xc-watchdog
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/xc-watchdog

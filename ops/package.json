{
  "name": "thesauros-crosschain-ops",
  "private": true,
  "description": "Off-chain services for the Thesauros cross-chain vault: NAV updater, epoch keeper, CCTP relayer, monitor, indexer + API",
  "scripts": {
    "nav": "ts-node --transpile-only src/nav.ts",
    "keeper": "ts-node --transpile-only src/keeper.ts",
    "relayer": "ts-node --transpile-only src/relayer.ts",
    "monitor": "ts-node --transpile-only src/monitor.ts",
    "verify-tick": "ts-node --transpile-only src/verify-tick.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --require ts-node/register/transpile-only --test test/*.test.ts",
    "indexer": "ts-node --transpile-only src/indexer.ts",
    "exec": "ts-node --transpile-only src/exec.ts",
    "preflight": "ts-node --transpile-only src/preflight.ts",
    "operators": "ts-node --transpile-only src/operators.ts",
    "solana": "ts-node --transpile-only src/solana/cli.ts",
    "solana:observer": "ts-node --transpile-only src/solana/observer.ts",
    "test:solana-sbf": "node --require ts-node/register/transpile-only test/solana-sbf.e2e.ts",
    "test:solana-cctp": "node --require ts-node/register/transpile-only test/solana-sbf.e2e.ts --real-cctp"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "13.0.3",
    "@solana/kit": "2.3.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "bn.js": "5.2.5",
    "bs58": "5.0.0",
    "decimal.js": "10.6.0",
    "ethers": "6.16.0"
  },
  "overrides": {
    "bigint-buffer": "$bigint-buffer",
    "toml": "5.0.1",
    "ws": "8.22.1",
    "uuid": "11.1.1",
    "stream-json": "3.8.0"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "ts-node": "10.9.2",
    "typescript": "^5.4.0"
  }
}

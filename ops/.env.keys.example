# Copy to ops/.env.keys on the server (chmod 600). Only the signing services,
# preflight and the exec CLI receive this file. Never commit it.
#
# Stand: every role is the deployer key 0xafA9ed53c33bbD8DE300481ce150dB3D35738F9D.
# Production: four distinct keys (06-rotate-governance.ts), OPS_LAYOUT=separate.
NAV_UPDATER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=

# Optional Solana signers are Ed25519 JSON file paths, separate from EVM keys.
# Mount the files read-only only into the corresponding signing services.
# SOLANA_EXECUTOR_KEYPAIR=/keys/solana-executor.json
# SOLANA_RELAYER_KEYPAIR=/keys/solana-relayer.json
# SOLANA_CHECKPOINT_KEYPAIR=/keys/solana-checkpoint.json

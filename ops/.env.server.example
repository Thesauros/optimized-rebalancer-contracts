# Copy to ops/.env.server on the server (chmod 600). No private keys here:
# this file is also given to the read-only monitor and indexer.

# RPC: reads (logs, archive state) and broadcasts go to different endpoints.
# Moralis silently dropped signed transactions during deployment, so signed
# transactions go through the chains' public endpoints only.
RPC_BASE=https://site2.moralis-nodes.com/base/<project-id>
RPC_ARBITRUM=https://site2.moralis-nodes.com/arbitrum/<project-id>
RPC_SEND_BASE=https://mainnet.base.org
RPC_SEND_ARBITRUM=https://arb1.arbitrum.io/rpc

# Per-process read budgets. Compose sets operators to 40 CU/s and monitor to 12.
# Leave headroom for other users of the same RPC node (getLogs costs 12 CU).
RPC_REQUESTS_PER_SECOND=10
RPC_COMPUTE_UNITS_PER_SECOND=24

# must equal the manifests' profile, or every deployment check fails (preflight enforces it)
CROSSCHAIN_PROFILE=stand

# identities the monitor verifies on-chain (stand: all the deployer)
CROSSCHAIN_SAFE=0xafA9ed53c33bbD8DE300481ce150dB3D35738F9D
CROSSCHAIN_NAV_UPDATER=0xafA9ed53c33bbD8DE300481ce150dB3D35738F9D
CROSSCHAIN_EXECUTOR=0xafA9ed53c33bbD8DE300481ce150dB3D35738F9D
CROSSCHAIN_GUARDIAN=0xafA9ed53c33bbD8DE300481ce150dB3D35738F9D

# preflight layout: operators (stand, one key) | separate (production)
OPS_LAYOUT=operators

# NAV cadence; a closed epoch waiting for a post-cutoff tick triggers one earlier
NAV_INTERVAL_SECONDS=3600
# keeper: deliver claims to receivers (pays gas) and recall hub liquidity for redemptions
KEEPER_CLAIM_FOR_USERS=true
KEEPER_AUTOFUND=false
RELAYER_ATTESTATION=iris

# alerts (the Thesauros alert bot); unset = alerts only in the logs
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# hot wallets whose gas the monitor watches: label=address,...
MONITOR_WATCH_BALANCES=deployer=0xafA9ed53c33bbD8DE300481ce150dB3D35738F9D
MONITOR_MIN_GAS_WEI=200000000000000

# indexer API: the frontend origin allowed by CORS
INDEXER_CORS_ORIGIN=https://<frontend-domain>

# Stand: Base estimates underfunded nested clearDeposits calls; allow 2x gas.
TX_GAS_MARGIN_BPS=10000
